# Core upload settings
DUMMER_LOCAL_PATH=/dsk8/catalina/gbo.ast.catalina.survey
DUMMER_CONFIG=/home/dum/conf.default.ini
DUMMER_NAME=sbn
DUMMER_DUM_BINARY=/usr/local/bin/pds-ingress-client

# Optional DUM/path overrides
DUMMER_BUNDLE=gbo.ast.catalina.survey
DUMMER_PREFIX=/dsk8/catalina
DUMMER_THREADS=12
DUMMER_LOG_LEVEL=warn

# Reporting
DUMMER_REPORT_DIR=/var/log/dum_pipeline/reports/
DUMMER_PIPELINE_REPORT_DIR=/var/log/dum_pipeline/runner/
# Optional per-directory DUM checksum manifest cache. Incompatible with direct file-list upload.
# DUMMER_DUM_MANIFEST_STORE=/var/lib/dummer/dum-manifests/

# Workflow defaults
DUMMER_SCRIPT_DIR=.
# Optional local inventory shortcuts. If neither is set, Dummer inventories DUMMER_LOCAL_PATH.
# DUMMER_LOCAL_STATE=./local_dirs.txt
# DUMMER_LOCAL_MANIFEST=/dsk8/catalina/catalina_extras/file_list.latest.txt.gz

# Choose exactly one processed source for dummer.py:
DUMMER_PROCESSED_STATE=./processed_dirs.txt
# DUMMER_PROCESSED_MANIFEST=
# DUMMER_PROCESSED_CRAWL=
# DUMMER_PROCESSED_S3_BUCKET=
DUMMER_MAX_DIRS=1
DUMMER_LOOP=false
DUMMER_INTERACTIVE=false
# DUMMER_DIRECT_FILE_LIST_UPLOAD=false
# DUMMER_DIRECT_FILE_LIST_BATCH_SIZE=500

# Optional filters
# DUMMER_PATH_FILTER=2026
# DUMMER_PATH_FILTER_DEPTH=2
# DUMMER_SUMMARY_ANCHOR_COMPONENT=2
# DUMMER_LOCAL_ROOT=gbo.ast.catalina.survey
# DUMMER_PROCESSED_ROOT=
# DUMMER_PROCESSED_S3_PREFIX=
# DUMMER_PROCESSED_S3_REGION=
# DUMMER_PROCESSED_S3_KNOWN_DIRS_FILE=
# DUMMER_PROCESSED_S3_KNOWN_DIRS_WORKERS=10
# DUMMER_PROCESSED_S3_RESUME_FROM_STATE=false
# DUMMER_PROCESSED_S3_MAX_RETRIES=10
# DUMMER_PROCESSED_S3_RETRY_DELAY_SECONDS=2.0
